# Copy to `.env` for local dev, and set the same two vars in Netlify
# (Site configuration → Environment variables). Both are safe for the
# frontend — the publishable/anon key is guarded by row-level security.
#
# Leave these unset (or as the placeholders below) and the app runs on its
# bundled live data; tips and accounts are then disabled.
#
# Page data (forecasts/actuals/scores/speakers) always comes from the bundle
# unless you also opt in to reading the Supabase tables:
# VITE_DATA_SOURCE=supabase

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
